{
  "name": "gimo-finanzas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1 --port 5192 --strictPort",
    "build": "tsc --noEmit && vite build --configLoader runner && node scripts/build-sw.mjs",
