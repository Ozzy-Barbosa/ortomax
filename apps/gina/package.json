    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  }
